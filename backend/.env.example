# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/project_management
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional (defaults shown)
JWT_EXPIRES_IN=1d
PORT=5000
# Comma-separated web origins allowed by CORS; "*" allows any (Bearer-token auth, no cookies)
CORS_ORIGIN=*
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
